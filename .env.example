# ============================================================
# Sistema de Reservas Club Amsterdam — Variables de entorno
# ============================================================
# Copiar este archivo a .env y completar los valores.
# NUNCA commitear el archivo .env con valores reales.

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
# SQLite para desarrollo local:
DATABASE_URL=sqlite:///./booking_local.db

# PostgreSQL para producción:
# DATABASE_URL=postgresql://user:password@host:5432/booking_db

# ------------------------------------------------------------
# Seguridad / JWT
# ------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
ADMIN_JWT_EXPIRE_MINUTES=720

# ------------------------------------------------------------
# Cron jobs
# ------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# ------------------------------------------------------------
# CORS — orígenes permitidos (separados por coma)
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# Producción (ejemplo):
# ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT=json   # json (default, producción) | text (desarrollo)

# ------------------------------------------------------------
# WhatsApp / Notificaciones (opcional, actualmente stub)
# ------------------------------------------------------------
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
